# Phase 7 PostgreSQL operational memory (M8) -- example environment file.
#
# Copy to `.env` for local use (`.env` is git- and docker-ignored; never
# commit real credentials, and never commit a real DSN, per task §10).
# docker-compose.yml sets its own values for its services; this file is
# for running `scripts/migrate.py` / `scripts/memory_smoke_test.py` or
# the test suite directly on the host, against either the disposable
# `docker compose up -d postgres` instance or an external PostgreSQL.

# Runtime application DSN (a role with neither SUPERUSER nor BYPASSRLS).
# Local disposable PostgreSQL (after `docker compose up -d postgres`):
AP_AGENT_POSTGRES_DSN=postgresql://ap_agent_app:ap_agent_app_dev_password@localhost:5433/ap_agent?sslmode=disable

# Migration-owner DSN (may create schemas/tables/policies/triggers).
AP_AGENT_POSTGRES_MIGRATION_DSN=postgresql://ap_agent_migrator:ap_agent_migrator_dev_password@localhost:5433/ap_agent?sslmode=disable

# Runtime role to grant least-privilege schema access to after migrating
# (scripts/migrate.py); unset to skip the grant step (e.g. against Neon,
# where the runtime role is typically provisioned by the platform).
AP_AGENT_POSTGRES_RUNTIME_ROLE=ap_agent_app

# --- Example: Neon / external PostgreSQL -----------------------------------
# Neon requires SSL; channel binding is an optional, stricter policy this
# module supports but does not require by default (see
# ap_agent.config.postgres.PostgresTransportPolicy). Never commit the real
# values below -- this is a syntax example only.
#
# AP_AGENT_POSTGRES_DSN=postgresql://<runtime_role>:<password>@<neon-project>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require
# AP_AGENT_POSTGRES_MIGRATION_DSN=postgresql://<migration_role>:<password>@<neon-project>.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require

# --- Dedicated PostgreSQL acceptance-test DSN -------------------------------
# tests/integration/test_memory_postgres_integration.py (requires_postgres)
# reads *only* this variable -- deliberately separate from
# AP_AGENT_POSTGRES_DSN/AP_AGENT_POSTGRES_MIGRATION_DSN above (the
# production runtime/migration names) so the acceptance suite can never
# silently run its UPDATE/DELETE/TRUNCATE-rejection and role-creation
# tests against whatever database those happen to point at. The suite
# refuses to run (fail-closed) unless this DSN's `dbname` is exactly the
# isolated test database it expects; see that file's module docstring and
# docs/m8_phase_7_postgres_memory_report.md §27 for the current
# acceptance-gate run and its owning-role vs. dedicated-least-privilege
# test-runtime-role split (the suite creates the latter itself).
#
# AP_AGENT_TEST_POSTGRES_DSN=postgresql://<owner_role>:<password>@<isolated-test-branch-endpoint>.<region>.aws.neon.tech/<isolated_test_database>?sslmode=require&channel_binding=require

# --- M11E: hosted deployment (placeholders only; see docs/m11e_deployment_runbook.md) -----
# Local development and tests keep the defaults (prototype_headers, local filesystem).
# A hosted deployment sets AP_AGENT_ENVIRONMENT=hosted and then REQUIRES every value below;
# startup fails closed (naming the setting, never its value) if one is missing or unsafe.
#
# AP_AGENT_ENVIRONMENT=hosted                    # development (default) | test | hosted
# AP_AGENT_AUTH_MODE=clerk_jwt                   # prototype_headers (default, dev/test only) | clerk_jwt
# AP_AGENT_CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev
# AP_AGENT_CLERK_AUTHORIZED_PARTIES=https://<web-host>      # comma-separated origins of the web service
# AP_AGENT_CLERK_JWKS_URL=                       # optional; defaults to <issuer>/.well-known/jwks.json
#
# AP_AGENT_ARTIFACT_STORAGE=s3                   # local (default, dev/test only) | s3
# AP_AGENT_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AP_AGENT_S3_BUCKET=<private-bucket-name>
# AP_AGENT_S3_ACCESS_KEY_ID=<r2-access-key-id>
# AP_AGENT_S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
# AP_AGENT_S3_REGION=auto
#
# Worker (hosted): AP_AGENT_ENABLE_WORKER_EXECUTION=true, AP_AGENT_WORKER_OCR_PROVIDER=paddleocr,
# AP_AGENT_REFERENCE_DATA_DIRECTORY=<directory> (the worker image sets it).
# Runtime and migration DSNs above must be different roles.
