# Server-only configuration for the M11A human-review frontend.
#
# Every value here is read only by server-side code under `src/lib` and
# `src/app/api/backend` (M11A task §5). None of these are prefixed
# `NEXT_PUBLIC_`, so none of them are ever bundled into browser JavaScript
# or exposed in rendered HTML. Copy this file to `.env.local` for local
# development and fill in real values there -- `.env.local` is gitignored.
#
# Never place AP_AGENT_TEST_POSTGRES_DSN, AP_AGENT_POSTGRES_DSN, or any
# other database credential in this file or in `.env.local`: the Next.js
# server never connects to PostgreSQL directly (browser -> Next.js server
# boundary -> FastAPI -> PostgreSQL only).

# Base URL of the modular M10 FastAPI application this frontend proxies to.
AP_AGENT_API_BASE_URL=http://127.0.0.1:8000

# Authentication mode for the server-side API boundary. "development_headers"
# is the only supported value in M11A: it attaches the FastAPI
# development/test header-authentication adapter's four headers
# (X-Tenant-ID, X-Actor-ID, X-Actor-Role, X-Authenticated-At) to every
# proxied request. This is explicitly NOT production authentication -- see
# docs/m11a_frontend_foundation_report.md, "Development-authentication
# limitation". A future milestone replaces this with OIDC/JWT.
AP_AGENT_FRONTEND_AUTH_MODE=development_headers

# Placeholders only -- never a real tenant/actor identifier.
AP_AGENT_DEV_TENANT_ID=00000000-0000-0000-0000-000000000000
AP_AGENT_DEV_ACTOR_ID=local-reviewer
AP_AGENT_DEV_ACTOR_ROLE=READ_ONLY_AUDITOR
