            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotency Key",
            "type": "string"
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "observed_review_revision": {
            "minimum": 1,
            "title": "Observed Review Revision",
            "type": "integer"
          },
          "observed_workflow_revision": {
            "minimum": 1,
            "title": "Observed Workflow Revision",
            "type": "integer"
          },
          "reason_codes": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Reason Codes",
            "type": "array"
          },
          "requested_at": {
            "format": "date-time",
            "title": "Requested At",
            "type": "string"
          }
        },
        "required": [
          "command_id",
          "idempotency_key",
          "action",
          "observed_review_revision",
          "observed_workflow_revision",
          "requested_at"
        ],
        "title": "ApiReviewCommandRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HumanReviewDisposition": {
        "enum": [
          "APPROVED",
          "REJECTED",
          "HOLD",
          "NEEDS_INFORMATION",
          "CORRECTED"
        ],
        "title": "HumanReviewDisposition",
        "type": "string"
      },
      "InvoiceFieldName": {
        "enum": [
          "SUPPLIER_NAME",
          "SUPPLIER_ADDRESS",
          "CUSTOMER_NAME",
          "CUSTOMER_ADDRESS",
          "INVOICE_NUMBER",
          "INVOICE_DATE",
          "DUE_DATE",
          "PURCHASE_ORDER_NUMBER",
          "CURRENCY",
          "SUBTOTAL",
          "TAX_AMOUNT",
          "DISCOUNT_AMOUNT",
          "SHIPPING_AMOUNT",
          "TOTAL_AMOUNT",
          "PAYMENT_TERMS",
          "LINE_DESCRIPTION",
          "LINE_QUANTITY",
          "LINE_UNIT_PRICE",
          "LINE_AMOUNT"
        ],
        "title": "InvoiceFieldName",
        "type": "string"
      },
      "ReviewAction": {
        "enum": [
          "CLAIM",
          "RELEASE",
          "ACCEPT",
          "CORRECT",
          "CONFIRM_SUPPLIER",
          "CONFIRM_PURCHASE_ORDER",
          "REQUEST_INFORMATION",
          "ESCALATE",
          "REJECT",
          "RESUME_WORKFLOW"
        ],
        "title": "ReviewAction",
        "type": "string"
      },
      "ReviewPriority": {
        "enum": [
          "LOW",
          "NORMAL",
          "HIGH",
          "CRITICAL"
        ],
        "title": "ReviewPriority",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
