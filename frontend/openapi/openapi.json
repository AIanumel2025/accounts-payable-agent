{
  "components": {
    "schemas": {
      "ApiCorrectionRequest": {
        "additionalProperties": false,
        "properties": {
          "corrected_value": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Corrected Value",
            "type": "string"
          },
          "evidence_reference_ids": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Reference Ids",
            "type": "array"
          },
          "field_name": {
            "$ref": "#/components/schemas/InvoiceFieldName"
          },
          "line_number": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line Number"
          },
          "previous_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Value"
          },
          "reason": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "field_name",
          "corrected_value",
          "reason",
          "evidence_reference_ids"
        ],
        "title": "ApiCorrectionRequest",
        "type": "object"
      },
      "ApiEnvelope": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "errors": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Errors",
            "type": "array"
          },
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "status",
          "generated_at"
        ],
        "title": "ApiEnvelope",
        "type": "object"
      },
      "ApiReviewCommandRequest": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/components/schemas/ReviewAction"
          },
          "command_id": {
            "format": "uuid",
            "title": "Command Id",
            "type": "string"
          },
          "corrections": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ApiCorrectionRequest"
            },
            "title": "Corrections",
            "type": "array"
          },
          "disposition": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HumanReviewDisposition"
              },
              {
                "type": "null"
              }
            ]
          },
